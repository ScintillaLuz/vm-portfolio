---
layout: base
title: Writing
---

<section>
  <h1>Writing</h1>
  <ul>
    {% for post in collections.writing %}
      <li>
        <a href="{{ post.url }}">{{ post.data.title }}</a>
        {% if post.data.description %}<p>{{ post.data.description }}</p>{% endif %}
      </li>
    {% endfor %}
  </ul>
</section>
