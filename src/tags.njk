---
layout: base.njk
pagination:
  data: collections
  size: 1
  alias: tag
  filter:
    - all
    - projects
    - designNotes
permalink: /tags/{{ tag | slugify }}/
---

<section>
  <h1>Projects tagged "{{ tag }}"</h1>
  <ul>
    {% set taggedProjects = collections[tag] %}
    {% for project in taggedProjects %}
    <li>
      <a href="{{ project.url }}">{{ project.data.title }}</a>
      {% if project.data.blurb %}<p>{{ project.data.blurb }}</p>{% endif %}
    </li>
    {% endfor %}
  </ul>
</section>