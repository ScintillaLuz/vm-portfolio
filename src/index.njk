---
layout: base
title: Home
---

<section class="intro">
  <h1>Valentina Montagna</h1>
  <p><!-- tagline or short intro goes here --></p>
</section>

<section class="featured-projects">
  <h2>Selected Projects</h2>
  <ul>
    {% for project in collections.projects | reverse %}
      <li>
        <a href="{{ project.url }}">{{ project.data.title }}</a>
        {% if project.data.description %}<p>{{ project.data.description }}</p>{% endif %}
      </li>
    {% endfor %}
  </ul>
</section>

<section class="recent-writing">
  <h2>Writing</h2>
  <ul>
    {% for post in collections.writing | reverse %}
      <li>
        <a href="{{ post.url }}">{{ post.data.title }}</a>
      </li>
    {% endfor %}
  </ul>
</section>
