---
layout: base
has_sidebar: true
---

<div class="grid-layout">
  <article class="main-content case-study">
    <h1>{{ title }}</h1>
    <div class="project-meta">
      <time datetime="{{ date }}">{{ date }}</time>
      <span class="company">{{ company }}</span>
    </div>
    {{ content | safe }}
  </article>

  <nav class="sidebar case-study-toc" aria-label="Table of contents">
    <h3>Contents</h3>
    <ul>
      {% set headings = content | toc %}
      {% for heading in headings %}
      <li>
        <a href="#{{ heading.id }}">{{ heading.text }}</a>
      </li>
      {% endfor %}
    </ul>
  </nav>
</div>
