---
layout: base
has_sidebar: true
---

<article class="project-detail content-layout">
  <header class="project-detail-header">
    <a href="/#projects" class="back-link">← All projects</a>
    <h1 class="project-detail-title">{{ title }}</h1>
    <div class="project-detail-meta">
      <time datetime="{{ date }}">{{ date | monthYear }}</time>
      <span class="company">{{ company }}</span>
    </div>
  </header>

  {% if glance %}
    <section class="at-a-glance" aria-labelledby="glance-heading">
      <h2 id="glance-heading" class="at-a-glance__heading">At a glance</h2>
      <dl class="at-a-glance__list">
        {% for field in glanceFields %}
          {% set value = glance[field.key] %}
          {% if value %}
            <div class="at-a-glance__row">
              <dt>{{ field.label }}</dt>
              <dd>{% if value is iterable and value is not string %}{{ value | join(", ") }}{% else %}{{ value }}{% endif %}</dd>
            </div>
          {% endif %}
        {% endfor %}
      </dl>
    </section>
  {% endif %}

  {{ content | safe }}

  {% if tags %}
    <div class="project-tags">
      <span class="tags-label visually-hidden">Categories</span>
      <ul role="list">
        {% for tag in tags %}
        <li><a class="tag" href="/tags/{{ tag | slugify }}/">{{ tag }}</a></li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}

  <a href="/#projects" class="primary-button back-link"><span aria-hidden="true">←</span> Back to all projects</a>
    

</article>
