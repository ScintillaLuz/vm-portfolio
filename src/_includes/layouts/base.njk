<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <script>
      (function () {
        const palette = localStorage.getItem("palette");
        if (palette === "magenta") {
          document.documentElement.setAttribute("data-palette", "magenta");
        }

        const theme = localStorage.getItem("theme");
        if (theme === "dark") {
          document.documentElement.setAttribute("data-theme", "dark");
        }

        const cursor = localStorage.getItem("cursor");
        if (cursor === "custom") {
          document.documentElement.setAttribute("data-cursor", "custom");
        }
      })();
    </script>

    <title>{{ title }} – Valentina Montagna</title>
    <meta name="description" content="{{ description or site.description }}">

    <!-- Open Graph / social sharing -->
    <meta property="og:title" content="{{ title }} – Valentina Montagna">
    <meta property="og:description" content="{{ description or site.description }}">
    <meta property="og:image" content="{{ site.url }}{{ ogImage or '/assets/og-default.png' }}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta property="og:type" content="website">
    <meta name="twitter:card" content="summary_large_image">

    <link rel="stylesheet" href="/assets/style.css">
  </head>
  <body id="top">
      <header class="page-header">
        {% include "nav.njk" %}
      </header>
    <div class="site-wrapper">
      <main>
        {% if has_sidebar %}
          {{ content | safe }}
        {% else %}
          <div class="page-content">
            {{ content | safe }}
          </div>
        {% endif %}
      </main>
      {% include "footer.njk" %}
    </div>
    <script src="/assets/js/header.js"></script>
    <script src="/assets/js/gallery.js"></script>
    <script src="/assets/js/palette.js"></script>
    <script src="/assets/js/theme.js"></script>
    <script src="/assets/js/cursor.js"></script>
  </body>
</html>
