---
layout: base
has_sidebar: true
---

<article class="post">
  <header class="post__header">
    <h1>{{ title }}</h1>
    {% if date %}<time datetime="{{ date | htmlDateString }}">{{ date | readableDate }}</time>{% endif %}
    {% if description %}<p class="post__description">{{ description }}</p>{% endif %}
  </header>

  <div class="post__layout">
    <div class="post__body">
      {{ content | safe }}
    </div>
  </div>
</article>
